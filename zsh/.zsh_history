: 1788722718:0;python3 <<'PY'\
from pathlib import Path\
import struct\
import zlib\
\
p = Path.home() / ".cache/hyprlock/transparent.png"\
p.parent.mkdir(parents=True, exist_ok=True)\
\
def chunk(kind, data):\
    return (\
        struct.pack(">I", len(data))\
        + kind\
        + data\
        + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)\
    )\
\
# PNG RGBA 1x1 completamente transparente.\
png = b"\x89PNG\r\n\x1a\n"\
png += chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0))\
png += chunk(b"IDAT", zlib.compress(b"\x00\x00\x00\x00\x00"))\
png += chunk(b"IEND", b"")\
\
p.write_bytes(png)\
\
print(p)\
PY\
\
