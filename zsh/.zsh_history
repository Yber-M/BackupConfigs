    echo '=== NVIDIA PROCESOS ==='\
    nvidia-smi pmon -c 1 2>&1\
\
    echo\
    echo '=== XDPH / PIPEWIRE √É∫LTIMAS 150 L√É≠NEAS ==='\
    [[ -f "$jlog" ]] && tail -n 150 "$jlog"\
\
    echo\
