: 1788720929:0;cat > ~/.config/hypr/scripts/hyprlock-media.sh <<'EOF'\
#!/usr/bin/env bash\
set -u\
\
action="${1:-text}"\
\
cache="${XDG_CACHE_HOME:-$HOME/.cache}/hyprlock"\
url_file="$cache/mpris-art.url"\
path_file="$cache/mpris-art.path"\
\
player="$(playerctl -l 2>/dev/null | tail -n1)"\
\
case "$action" in\
    text)\
        [[ -n "$player" ]] || exit 0\
\
        playerctl metadata -p "$player" \\
            --format '{{title}} Û∞ÉÆÉ® {{artist}}' \\
            2>/dev/null || true\
        ;;\
\
    art)\
        [[ -n "$player" ]] || exit 0\
\
        url="$(\
            playerctl metadata -p "$player" \\
                mpris:artUrl 2>/dev/null || true\
        )"\
\
        [[ -n "$url" ]] || exit 0\
\
        mkdir -p "$cache"\
\
        # Si la portada no cambi√≥, reutilizar el archivo existente.\
        if [[ -r "$url_file" && -r "$path_file" ]]; then\
            old_url="$(cat "$url_file")"\
            old_path="$(cat "$path_file")"\
\
            if [[ "$url" == "$old_url" && -f "$old_path" ]]; then\
                printf '%s\n' "$old_path"\
                exit 0\
            fi\
        fi\
\
        tmp="$(mktemp "$cache/.mpris-art.XXXXXX")"\
\
        case "$url" in\
            http://\*\|https://\*\)\
                if ! curl \\
                    -LfsS \\
                    --connect-timeout 3 \\
                    --max-time 8 \\
                    "$url" \\
                    -o "$tmp"\
                then\
                    rm -f "$tmp"\
\
                    # Si falla Internet, conservar la √∫ltima portada.\
                    if [[ -r "$path_file" ]]; then\
                        old_path="$(cat "$path_file")"\
                        [[ -f "$old_path" ]] && printf '%s\n' "$old_path"\
                    fi\
\
                    exit 0\
                fi\
                ;;\
\
            file://*)\
                local_path="$(\
                    python3 - "$url" <<'PY'\
import sys\
from urllib.parse import urlparse, unquote\
\
print(unquote(urlparse(sys.argv[1]).path))\
PY\
                )"\
\
                if [[ ! -f "$local_path" ]]; then\
                    rm -f "$tmp"\
                    exit 0\
                fi\
\
                cp -- "$local_path" "$tmp"\
                ;;\
\
            *)\
                rm -f "$tmp"\
                exit 0\
                ;;\
        esac\
\
        mime="$(file -b --mime-type "$tmp")"\
\
        case "$mime" in\
            image/jpeg)\
                dest="$cache/mpris-art.jpg"\
                ;;\
            image/png)\
                dest="$cache/mpris-art.png"\
                ;;\
            image/webp)\
                dest="$cache/mpris-art.webp"\
                ;;\
            *)\
                rm -f "$tmp"\
                exit 0\
                ;;\
        esac\
\
        rm -f \\
            "$cache/mpris-art.jpg" \\
            "$cache/mpris-art.png" \\
            "$cache/mpris-art.webp"\
\
        mv "$tmp" "$dest"\
\
        printf '%s' "$url" > "$url_file"\
        printf '%s' "$dest" > "$path_file"\
\
        printf '%s\n' "$dest"\
        ;;\
\
    next)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" next 2>/dev/null || true\
        ;;\
\
    previous)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" previous 2>/dev/null || true\
        ;;\
\
    toggle)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" play-pause 2>/dev/null || true\
        ;;\
\
    *)\
        exit 2\
        ;;\
esac\
EOF\
\
chmod +x ~/.config/hypr/scripts/hyprlock-media.sh
