cat > ~/.config/hypr/scripts/screenshot.sh <<'EOF'\
#!/usr/bin/env bash\
# Screenshot helper (grim + slurp), reemplazo directo de hyde-shell screenshot\
set -euo pipefail\
\
DIR="$HOME/Pictures/Screenshots"\
mkdir -p "$DIR"\
FILE="$DIR/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png"\
\
mode="${1:-region}"\
\
case "$mode" in\
  region)\
    geom=$(slurp) || exit 1\
    grim -g "$geom" "$FILE"\
    ;;\
  output)\
    mon=$(hyprctl activeworkspace -j | jq -r .monitor)\
    grim -o "$mon" "$FILE"\
    ;;\
  full)\
    grim "$FILE"\
    ;;\
  *)\
    echo "modo desconocido: $mode" >&2\
    exit 1\
    ;;\
esac\
\
wl-copy < "$FILE"\
notify-send "Screenshot" "Guardado en $FILE" 2>/dev/null || true\
EOF\
chmod +x ~/.config/hypr/scripts/screenshot.sh
