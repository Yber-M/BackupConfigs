: 1788588567:0;preview_anim() {\
    local name="$1"\
    local file="$HOME/.config/hypr/animations/$name.conf"\
\
    if [[ ! -f "$file" ]]; then\
        echo "No existe: $file"\
        return 1\
    fi\
\
    # Volvemos primero a nuestra configuraci√≥n Lua actual.\
    hyprctl reload >/dev/null\
\
    while IFS= read -r line; do\
        # Quitar espacios iniciales.\
        line="${line#"${line%%[space:]]*}"}"\
\
        case "$line" in\
            "bezier = "*)\
                value="${line#bezier = }"\
                hyprctl keyword bezier "$value" >/dev/null\
                ;;\
            "animation = "*)\
                value="${line#animation = }"\
                hyprctl keyword animation "$value" >/dev/null\
                ;;\
        esac\
    done < "$file"\
\
    echo "‚ÉºÉ≥ Animaci√≥n temporal aplicada: $name"\
}
