import { Gtk } from "ags/gtk4";\
import { createState, createBinding, With } from "ags";\
import { PickerCoordinator } from "utils/picker";\
import type { WallpaperItem } from "utils/picker/types.ts";\
import { WallpaperThumbnail } from "./WallpaperThumbnail.tsx";\
\
interface WallpaperGridProps {\
  items: WallpaperItem[];\
  picker: PickerCoordinator;\
}\
\
const INITIAL_PAGE_SIZE = 9; // 3 filas x 3 columnas\
const PAGE_INCREMENT = 6; // 2 filas por lote adicional\
const COLS = 3;\
const KEYBOARD_LOOKAHEAD = 6; // margen antes de que el teclado alcance el borde\
\
export function WallpaperGrid({ items, picker }: WallpaperGridProps) {\
  const [visibleCount, setVisibleCount] = createState(\
    Math.min(INITIAL_PAGE_SIZE, items.length),\
  );\
\
  const growTo = (target: number) => {\
    if (target > visibleCount.get()) {\
      setVisibleCount(Math.min(target, items.length));\
    }\
  };\
\
  const maybeLoadMore = (adj: Gtk.Adjustment) => {\
    const nearBottom =\
      adj.get_value() + adj.get_page_size() >= adj.get_upper() - 200;\
    if (nearBottom && visibleCount.get() < items.length) {\
      growTo(visibleCount.get() + PAGE_INCREMENT);\
    }\
  };\
\
  // Navegaci√≥n por teclado: precarga p√ÉÅginas antes de que el √≠ndice\
  // seleccionado alcance el borde de lo renderizado.\
  const selectedIndex = createBinding(picker, "selectedIndex");\
  selectedIndex.subscribe(() => {\
    const idx = selectedIndex.get();\
    if (idx + KEYBOARD_LOOKAHEAD >= visibleCount.get()) {\
      growTo(idx + KEYBOARD_LOOKAHEAD + PAGE_INCREMENT);\
    }\
  });\
\
  return (\
    <scrolledwindow\
      heightRequest={340}\
      vexpand={false}\
      hscrollbarPolicy={Gtk.PolicyType.NEVER}\
      vscrollbarPolicy={Gtk.PolicyType.AUTOMATIC}\
      $={(self) => {\
        const adj = self.get_vadjustment();\
        adj.connect("value-changed", () => maybeLoadMore(adj));\
      }}\
    >\
      <With value={visibleCount}>\
        {(count) => {\
          const visibleItems = items.slice(0, count);\
          return (\
            <box\
              orientation={Gtk.Orientation.VERTICAL}\
              spacing={8}\
              cssClasses={["wallpaper-content"]}\
            >\
              {Array.from(\
                { length: Math.ceil(visibleItems.length / COLS) },\
                (_, rowIndex) => (\
                  <box\
                    orientation={Gtk.Orientation.HORIZONTAL}\
                    spacing={8}\
                    cssClasses={["wallpaper-row"]}\
                  >\
                    {visibleItems\
                      .slice(rowIndex * COLS, (rowIndex + 1) * COLS)\
                      .map((item, colIndex) => {\
                        const itemIndex = rowIndex * COLS + colIndex;\
                        return (\
                          <WallpaperThumbnail\
                            item={item}\
                            picker={picker}\
                            itemIndex={itemIndex}\
                            onActivate={() => picker.activate(item)}\
                          />\
                        );\
                      })}\
                  </box>\
                ),\
              )}\
            </box>\
          );\
        }}\
      </With>\
    </scrolledwindow>\
  );\
}\
EOF
