\
old = '''const PAGE_SIZE = 15; // 5 filas x 3 columnas\
const COLS = 3;\
\
export function WallpaperGrid({ items, picker }: WallpaperGridProps) {\
  const [visibleCount, setVisibleCount] = createState(\
    Math.min(PAGE_SIZE, items.length),\
  );\
\
  const maybeLoadMore = (adj: Gtk.Adjustment) => {\
    const nearBottom =\
      adj.get_value() + adj.get_page_size() >= adj.get_upper() - 200;\
    if (nearBottom && visibleCount.get() < items.length) {\
      setVisibleCount(Math.min(visibleCount.get() + PAGE_SIZE, items.length));\
    }\
  };'''\
\
new = '''const INITIAL_PAGE_SIZE = 9; // 3 filas x 3 columnas\
const PAGE_INCREMENT = 6; // 2 filas por lote adicional\
const COLS = 3;\
\
export function WallpaperGrid({ items, picker }: WallpaperGridProps) {\
  const [visibleCount, setVisibleCount] = createState(\
    Math.min(INITIAL_PAGE_SIZE, items.length),\
  );\
\
  const maybeLoadMore = (adj: Gtk.Adjustment) => {\
    const nearBottom =\
      adj.get_value() + adj.get_page_size() >= adj.get_upper() - 200;\
    if (nearBottom && visibleCount.get() < items.length) {\
      setVisibleCount(\
        Math.min(visibleCount.get() + PAGE_INCREMENT, items.length),\
      );\
    }\
  };'''\
