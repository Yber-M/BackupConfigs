: 1788720178:0;cat > ~/.config/hypr/scripts/hyprlock-media.sh <<'EOF'\
#!/usr/bin/env bash\
set -u\
\
action="${1:-text}"\
player="$(playerctl -l 2>/dev/null | tail -n1)"\
\
case "$action" in\
    text)\
        if [[ -n "$player" ]]; then\
            text="$(\
                playerctl metadata -p "$player" \\
                    --format '{{title}} ÔÉ•º {{artist}}' \\
                    2>/dev/null || true\
            )"\
\
            if [[ -n "$text" ]]; then\
                printf '%s\n' "$text"\
            else\
                hyprctl splash 2>/dev/null || true\
            fi\
        else\
            hyprctl splash 2>/dev/null || true\
        fi\
        ;;\
\
    next)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" next 2>/dev/null || true\
        ;;\
\
    previous)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" previous 2>/dev/null || true\
        ;;\
\
    toggle)\
        [[ -n "$player" ]] &&\
            playerctl -p "$player" play-pause 2>/dev/null || true\
        ;;\
\
    *)\
        exit 2\
        ;;\
esac\
EOF\
\
chmod +x ~/.config/hypr/scripts/hyprlock-media.sh
: 1788720181:0;cat > ~/.config/hypr/scripts/hyprlock-battery.sh <<'EOF'\
#!/usr/bin/env bash\
\
for bat in /sys/class/power_supply/BAT*; do\
    [[ -r "$bat/capacity" ]] || continue\
\
    pct="$(cat "$bat/capacity" 2>/dev/null)"\
    status="$(cat "$bat/status" 2>/dev/null)"\
\
    [[ "$pct" =~ ^[0-9]+$ ]] || exit 0\
\
    if [[ "$status" == "Charging" ]]; then\
        icon="ÔÉ£ß"\
    elif (( pct >= 90 )); then\
        icon="ÔÉ©Ä"\
    elif (( pct >= 65 )); then\
        icon="ÔÉ©Å"\
    elif (( pct >= 40 )); then\
        icon="ÔÉ©Ç"\
    elif (( pct >= 15 )); then\
        icon="ÔÉ©É£"\
    else\
        icon="ÔÉ©É§"\
    fi\
\
    printf '%s %s%%\n' "$icon" "$pct"\
    exit 0\
done\
EOF\
\
chmod +x ~/.config/hypr/scripts/hyprlock-battery.sh
