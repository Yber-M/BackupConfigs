    [[ -f "$klog" ]] && tail -n 150 "$klog"\
\
    echo\
    echo '=== CARGA PREVIA √É∫LTIMAS 120 L√É≠NEAS ==='\
    [[ -f "$mlog" ]] && tail -n 120 "$mlog"\
\
    echo\
    echo '=== JOURNAL XDPH √É∫LTIMOS 3 MIN ==='\
    journalctl --user \\
      -u xdg-desktop-portal-hyprland.service \\
      --since '-3 min' --no-pager\
\
    echo\
    echo '=== KERNEL NVIDIA / GPU √É∫LTIMOS 3 MIN ==='\
    journalctl -k --since '-3 min' --no-pager |\
