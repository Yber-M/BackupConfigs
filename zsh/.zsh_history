python3 <<'PY'\
from pathlib import Path\
\
p = Path.home() / ".config/hypr/keybindings.lua"\
text = p.read_text()\
\
replacements = {\
    'hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("hyde-shell volumecontrol -i m"), { locked = true })':\
    'hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/audio-mute.sh input"), { locked = true })',\
\
    'hl.bind("XF86AudioMute", hl.dsp.exec_cmd("hyde-shell volumecontrol -o m"), { locked = true })':\
    'hl.bind("XF86AudioMute", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/audio-mute.sh output"), { locked = true })',\
\
    'hl.bind(mainMod .. " + K", hl.dsp.exec_cmd("hyde-shell keyboardswitch"), { desc = "toggle keyboard layout" })':\
    'hl.bind(mainMod .. " + K", hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/keyboard-layout.sh"), { desc = "toggle keyboard layout" })',\
}\
\
for old, new in replacements.items():\
    count = text.count(old)\
    assert count == 1, f"Esperaba exactamente 1 coincidencia para:\n{old}\nEncontr√©: {count}"\
    text = text.replace(old, new, 1)\
\
p.write_text(text)\
print("‚ÉºÉ≥ 3 dependencias activas de hyde-shell reemplazadas")\
PY\
\
