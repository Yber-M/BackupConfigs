#!/bin/bash\
cd ~/.local/share/ascii-art/textart\
OUTPUT=~/arte-favoritos.txt\
> "$OUTPUT"\
\
for f in *; do\
  clear\
  echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞ $f ‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
  cat "$f"\
  echo\
  echo ""\
  read -n1 -p "¬øTe gusta? [y/n/q para salir]: " resp\
  echo\
  case "$resp" in\
    y|Y)\
      echo "$f" >> "$OUTPUT"\
      ;;\
    q|Q)\
      echo "Saliendo. Favoritos guardados en $OUTPUT"\
      exit 0\
      ;;\
  esac\
done\
\
echo "Terminado. Favoritos guardados en $OUTPUT"\
EOF\
chmod +x ~/ver-arte.sh
