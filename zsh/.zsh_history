cat > ~/.config/hypr/scripts/post-resume.sh <<'EOF'\
#!/usr/bin/env bash\
set -euo pipefail\
\
# Dar tiempo a que Wayland/Hyprland terminen de restaurar la sesi√≥n.\
sleep 2\
\
# Matshell est√ÉÅ administrado por systemd --user.\
# Si ya est√ÉÅ activo, este comando no hace nada.\
# Si no est√ÉÅ activo, lo inicia.\
systemctl --user start matshell.service\
EOF\
\
chmod +x ~/.config/hypr/scripts/post-resume.sh\
\
bash -n ~/.config/hypr/scripts/post-resume.sh \\
  && echo "‚ÉºÉ≥ post-resume.sh v√ÉÅlido"\
\
echo\
echo "=== RESULTADO ==="\
cat ~/.config/hypr/scripts/post-resume.sh
