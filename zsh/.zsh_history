python3 - "$SWAPPY_CFG" <<'PY'\
from pathlib import Path\
import sys\
\
p = Path(sys.argv[1])\
\
if p.exists():\
    lines = p.read_text().splitlines()\
else:\
    lines = []\
\
target_dir = "/home/yb-m/Descargas"\
\
try:\
    start = lines.index("[Default]")\
except ValueError:\
    if lines and lines[-1].strip():\
        lines.append("")\
    lines.extend([\
        "[Default]",\
        f"save_dir={target_dir}",\
        "early_exit=true",\
    ])\
else:\
    end = len(lines)\
    for i in range(start + 1, len(lines)):\
        s = lines[i].strip()\
        if s.startswith("[") and s.endswith("]"):\
            end = i\
            break\
\
    found_save_dir = False\
    found_early_exit = False\
\
    for i in range(start + 1, end):\
        s = lines[i].strip()\
        if s.startswith("save_dir="):\
            lines[i] = f"save_dir={target_dir}"\
            found_save_dir = True\
        elif s.startswith("early_exit="):\
            lines[i] = "early_exit=true"\
            found_early_exit = True\
\
    insert_at = end\
    if not found_save_dir:\
        lines.insert(insert_at, f"save_dir={target_dir}")\
        insert_at += 1\
    if not found_early_exit:\
        lines.insert(insert_at, "early_exit=true")\
\
p.write_text("\n".join(lines) + "\n")\
print("OK:", p)\
PY
