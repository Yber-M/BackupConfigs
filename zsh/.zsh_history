else:\
    new_content = '''import { Gtk } from "ags/gtk4";\
import { createState, With } from "ags";\
import { PickerCoordinator } from "utils/picker";\
import type { WallpaperItem } from "utils/picker/types.ts";\
import { WallpaperThumbnail } from "./WallpaperThumbnail.tsx";\
\
interface WallpaperGridProps {\
  items: WallpaperItem[];\
  picker: PickerCoordinator;\
}\
\
const PAGE_SIZE = 15; // 5 filas x 3 columnas\
const COLS = 3;\
\
export function WallpaperGrid({ items, picker }: WallpaperGridProps) {\
  const [visibleCount, setVisibleCount] = createState(\
    Math.min(PAGE_SIZE, items.length),\
  );\
\
  const maybeLoadMore = (adj: Gtk.Adjustment) => {\
    const nearBottom =\
      adj.get_value() + adj.get_page_size() >= adj.get_upper() - 200;\
    if (nearBottom && visibleCount.get() < items.length) {\
      setVisibleCount(Math.min(visibleCount.get() + PAGE_SIZE, items.length));\
    }\
  };\
\
  return (\
    <scrolledwindow\
      heightRequest={340}\
      vexpand={false}\
      hscrollbarPolicy={Gtk.PolicyType.NEVER}\
      vscrollbarPolicy={Gtk.PolicyType.AUTOMATIC}\
      $={(self) => {\
        const adj = self.get_vadjustment();\
        adj.connect("value-changed", () => maybeLoadMore(adj));\
      }}\
    >\
      <With value={visibleCount}>\
        {(count) => {\
          const visibleItems = items.slice(0, count);\
          return (\
            <box\
              orientation={Gtk.Orientation.VERTICAL}\
              spacing={8}\
              cssClasses={["wallpaper-content"]}\
            >\
              {Array.from(\
                { length: Math.ceil(visibleItems.length / COLS) },\
                (_, rowIndex) => (\
                  <box\
                    orientation={Gtk.Orientation.HORIZONTAL}\
                    spacing={8}\
                    cssClasses={["wallpaper-row"]}\
                  >\
                    {visibleItems\
                      .slice(rowIndex * COLS, (rowIndex + 1) * COLS)\
                      .map((item, colIndex) => {\
                        const itemIndex = rowIndex * COLS + colIndex;\
                        return (\
                          <WallpaperThumbnail\
                            item={item}\
                            picker={picker}\
                            itemIndex={itemIndex}\
                            onActivate={() => picker.activate(item)}\
                          />\
                        );\
                      })}\
                  </box>\
                ),\
              )}\
            </box>\
          );\
        }}\
      </With>\
    </scrolledwindow>\
  );\
}\
'''\
    with open(path, "w") as f:\
        f.write(new_content)\
    print("OK: WallpaperGrid.tsx reescrito con paginaci√≥n + scroll contenido.")\
