: 1784863893:0;python3 << 'PYEOF'\
path = "/home/yb-m/.config/ags/style/components/_bar.scss"\
with open(path, "r") as f:\
    content = f.read()\
\
old = '''  .idle-inhibitor {\
    @include animate;\
    border-radius: $round2;\
    padding: 0.2rem 0.4rem;\
\
    .idle-icon {\
      @include material-icon($font);\
      color: $outline;\
    }\
\
    &:hover {\
      background: color.adjust($fg, $alpha: -0.9);\
    }\
\
    &.active {\
      background: color.adjust($primary, $alpha: -0.8);\
\
      .idle-icon {\
        color: $primary;\
      }\
    }\
  }'''\
\
new = '''  .idle-inhibitor {\
    @include animate;\
    border-radius: $round2;\
    padding: 0.2rem 0.4rem;\
\
    .idle-icon {\
      @include material-icon($font);\
      font-variation-settings: "FILL" 0;\
      color: $outline;\
    }\
\
    &:hover {\
      background: color.adjust($fg, $alpha: -0.9);\
    }\
\
    &.active {\
      .idle-icon {\
        font-variation-settings: "FILL" 1;\
        color: $primary;\
      }\
    }\
  }'''\
\
count = content.count(old)\
print(f"Coincidencias: {count}")\
\
if count == 1:\
    content = content.replace(old, new)\
    with open(path, "w") as f:\
        f.write(content)\
    print("OK: aplicado.")\
else:\
    print("No coincide, revisar.")\
