from pathlib import Path\
\
p = Path.home() / ".config/hypr/keybindings.lua"\
lines = p.read_text().splitlines()\
\
matches = [\
    i for i, line in enumerate(lines)\
    if 'mainMod .. " + L"' in line and 'hyprlock' in line\
]\
\
assert len(matches) == 1, \\
