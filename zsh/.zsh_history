: 1788744008:0;python3 <<'PY'\
from pathlib import Path\
import json\
\
base = Path.home() / ".config/google-chrome/Default/Extensions"\
\
if not base.exists():\
    print("No existe:", base)\
    raise SystemExit\
\
rows = []\
\
for ext_dir in sorted(base.iterdir()):\
    if not ext_dir.is_dir():\
        continue\
\
    versions = [\
        p for p in ext_dir.iterdir()\
        if p.is_dir() and (p / "manifest.json").exists()\
    ]\
\
    if not versions:\
        continue\
\
    version = sorted(versions)[-1]\
    manifest = json.loads(\
        (version / "manifest.json").read_text(errors="replace")\
    )\
\
    name = manifest.get("name", "(sin nombre)")\
    ver = manifest.get("version", "?")\
\
    rows.append((ext_dir.name, ver, name))\
\
for ext_id, version, name in rows:\
    print(f"{ext_id}\t{version}\t{name}")\
PY
