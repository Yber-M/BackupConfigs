: 1788588887:0;cat > ~/.config/hypr/scripts/preview-animation.sh <<'EOF'\
#!/usr/bin/env bash\
set -euo pipefail\
\
name="${1:-}"\
\
if [[ -z "$name" ]]; then\
    echo "Uso: preview-animation.sh <preset>"\
    exit 1\
fi\
\
file="$HOME/.config/hypr/animations/$name.conf"\
\
if [[ ! -f "$file" ]]; then\
    echo "No existe: $file"\
    exit 1\
fi\
\
# Regresar primero al estado definido en hyprland.lua.\
hyprctl reload >/dev/null\
\
while IFS= read -r raw; do\
    line="$(printf '%s\n' "$raw" | sed 's/^[[:space:]]*//')"\
\
    case "$line" in\
        "bezier = "*)\
            value="${line#bezier = }"\
            hyprctl keyword bezier "$value"\
            ;;\
        "animation = "*)\
            value="${line#animation = }"\
            hyprctl keyword animation "$value"\
            ;;\
    esac\
done < "$file"\
\
echo\
echo "‚ÉºÉ≥ Preview aplicado: $name"\
echo "Para volver a tu Dynamic actual: hyprctl reload"\
EOF\
\
chmod +x ~/.config/hypr/scripts/preview-animation.sh
