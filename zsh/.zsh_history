\
i = matches[0]\
old = lines[i]\
\
new = old.replace(\
    'hl.dsp.exec_cmd("hyprlock")',\
    'hl.dsp.exec_cmd(os.getenv("HOME") .. "/.config/hypr/scripts/lock.sh")'\
)\
\
assert new != old, f"No pude transformar la l√≠nea: {old}"\
\
lines[i] = new\
p.write_text("\n".join(lines) + "\n")\
\
print("ANTES:")\
print(old)\
print("\nDESPU√É©S:")\
print(new)\
PY\
\
hyprctl reload\
hyprctl configerrors
