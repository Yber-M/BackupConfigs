from pathlib import Path\
\
p = Path.home() / ".config/hypr/scripts/hyprlock-media.sh"\
text = p.read_text()\
\
# 1. Solo considerar reproductores realmente reproduciendo.\
old_get = '''        case "$status" in\
            Playing)\
                printf '%s\\n' "$p"\
                return 0\
                ;;\
            Paused)\
                [[ -z "$paused" ]] && paused="$p"\
                ;;\
        esac\
'''\
\
new_get = '''        if [[ "$status" == "Playing" ]]; then\
            printf '%s\\n' "$p"\
            return 0\
        fi\
'''\
\
count = text.count(old_get)\
assert count == 1, f"Bloque get_player esperado: 1, encontrado: {count}"\
text = text.replace(old_get, new_get, 1)\
\
old_return = '''    if [[ -n "$paused" ]]; then\
        printf '%s\\n' "$paused"\
        return 0\
    fi\
\
    return 1\
'''\
\
new_return = '''    return 1\
'''\
\
count = text.count(old_return)\
assert count == 1, f"Bloque paused esperado: 1, encontrado: {count}"\
text = text.replace(old_return, new_return, 1)\
\
# Ya no necesitamos esta variable.\
text = text.replace('    local paused=""\\n', '', 1)\
\
# 2. Sustituir el case problem√ÉÅtico de URL completo.\
start_marker = '        tmp="$(mktemp "$cache/.mpris-art.XXXXXX")"'\
end_marker = '        mime="$(file -b --mime-type "$tmp")"'\
\
start = text.find(start_marker)\
end = text.find(end_marker)\
\
assert start != -1, "No encontr√© el inicio del bloque de descarga"\
assert end != -1, "No encontr√© el final del bloque de descarga"\
assert end > start, "Los marcadores aparecen en orden incorrecto"\
\
replacement = '''        tmp="$(mktemp "$cache/.mpris-art.XXXXXX")"\
\
        scheme="${url%%:*}"\
\
        if [[ "$scheme" == "http" || "$scheme" == "https" ]]; then\
            if ! curl \\
                -LfsS \\
                --connect-timeout 3 \\
                --max-time 8 \\
                "$url" \\
                -o "$tmp"\
            then\
                rm -f "$tmp"\
\
                if [[ -r "$path_file" ]]; then\
                    old_path="$(cat "$path_file")"\
                    [[ -f "$old_path" ]] && printf '%s\\n' "$old_path"\
                fi\
\
                exit 0\
            fi\
\
        elif [[ "$scheme" == "file" ]]; then\
            local_path="$(\
                python3 -c \\
                'import sys, urllib.parse; print(urllib.parse.unquote(urllib.parse.urlparse(sys.argv[1]).path))' \\
                "$url"\
            )"\
\
            if [[ ! -f "$local_path" ]]; then\
                rm -f "$tmp"\
                exit 0\
            fi\
\
            cp -- "$local_path" "$tmp"\
\
        else\
            rm -f "$tmp"\
            exit 0\
        fi\
\
'''\
\
text = text[:start] + replacement + text[end:]\
\
p.write_text(text)\
print("OK: sintaxis URL corregida y media limitada a Playing")\
PY
