import re\
\
path = "/home/yb-m/.config/ags/utils/picker/SearchProvider.ts"\
with open(path, "r") as f:\
    content = f.read()\
\
old = '''  setDefaultResults(allItems: PickerItem[]) {\
    const maxResults = this.providerConfig?.maxResults;\
    const frecencyIds = this.frecencyManager.getDefaultItems(\
      this.command,\
      maxResults,\
    );\
    const defaults = frecencyIds\
      .map((id) => allItems.find((item) => item.id === id))\
      .filter(Boolean) as PickerItem[];\
\
    this.defaultResults = defaults;\
    this.results = defaults;\
    this.showingDefaults = true;\
    this.emit("results-changed", defaults);\
  }'''\
\
new = '''  setDefaultResults(allItems: PickerItem[]) {\
    // Pide el ranking de frecency sin l√≠mite: todas las apps con historial\
    const frecencyIds = this.frecencyManager.getDefaultItems(\
      this.command,\
      allItems.length,\
    );\
\
    const usedItems = frecencyIds\
      .map((id) => allItems.find((item) => item.id === id))\
      .filter(Boolean) as PickerItem[];\
\
    const usedIds = new Set(usedItems.map((item) => item.id));\
    const unusedItems = allItems\
      .filter((item) => !usedIds.has(item.id))\
      .sort((a, b) => a.name.localeCompare(b.name));\
\
    const defaults = [...usedItems, ...unusedItems];\
\
    this.defaultResults = defaults;\
    this.results = defaults;\
    this.showingDefaults = true;\
    this.emit("results-changed", defaults);\
  }'''\
\
if old not in content:\
    print("ERROR: el bloque original no coincide exactamente. Nada fue modificado.")\
else:\
    content = content.replace(old, new)\
    with open(path, "w") as f:\
        f.write(content)\
    print("OK: parche aplicado correctamente.")\
PYEOF
