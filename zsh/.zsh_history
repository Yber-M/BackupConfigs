: 1788589769:0;cat > ~/.config/hypr/scripts/set-animation.sh <<'EOF'\
#!/usr/bin/env bash\
set -euo pipefail\
\
profile="${1:-}"\
\
case "$profile" in\
    default) profile="dynamic" ;;\
esac\
\
case "$profile" in\
    dynamic|fast|optimized|moving) ;;\
    *)\
        echo "Uso: set-animation.sh {default|dynamic|fast|optimized|moving}"\
        exit 1\
        ;;\
esac\
\
file="$HOME/.config/hypr/animations/$profile.lua"\
active="$HOME/.config/hypr/animations/active.lua"\
\
test -f "$file" || {\
    echo "No existe: $file"\
    exit 1\
}\
\
ln -sfn "$file" "$active"\
hyprctl reload\
\
echo\
echo "Perfil activo:"\
readlink -f "$active"\
\
echo\
echo "Config errors:"\
hyprctl configerrors\
EOF\
\
chmod +x ~/.config/hypr/scripts/set-animation.sh
