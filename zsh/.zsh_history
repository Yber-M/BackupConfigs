from pathlib import Path\
\
p = Path.home() / ".config/hypr/keybindings.lua"\
lines = p.read_text().splitlines()\
\
# ----- RESIZE -----\
replacements = {\
    'hl.bind(mainMod .. " + SHIFT + right", hl.dsp.exec_cmd("hyprctl dispatch resizeactive 30 0"),  { repeating = true, desc = "resize right" })':\
    'hl.bind(mainMod .. " + SHIFT + right", hl.dsp.window.resize({ x = 30, y = 0, relative = true }), { repeating = true, desc = "resize right" })',\
\
    'hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.exec_cmd("hyprctl dispatch resizeactive -30 0"), { repeating = true, desc = "resize left" })':\
    'hl.bind(mainMod .. " + SHIFT + left", hl.dsp.window.resize({ x = -30, y = 0, relative = true }), { repeating = true, desc = "resize left" })',\
\
    'hl.bind(mainMod .. " + SHIFT + up",    hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 -30"), { repeating = true, desc = "resize up" })':\
    'hl.bind(mainMod .. " + SHIFT + up", hl.dsp.window.resize({ x = 0, y = -30, relative = true }), { repeating = true, desc = "resize up" })',\
\
    'hl.bind(mainMod .. " + SHIFT + down",  hl.dsp.exec_cmd("hyprctl dispatch resizeactive 0 30"),  { repeating = true, desc = "resize down" })':\
    'hl.bind(mainMod .. " + SHIFT + down", hl.dsp.window.resize({ x = 0, y = 30, relative = true }), { repeating = true, desc = "resize down" })',\
}\
\
for old, new in replacements.items():\
    assert lines.count(old) == 1, f"No se encontr√≥ exactamente:\n{old}"\
    lines[lines.index(old)] = new\
\
# ----- MOVIMIENTO INTELIGENTE -----\
old_start = 'local moveActive = [[grep -q "true" <<< $(hyprctl activewindow -j | jq -r .floating) && hyprctl dispatch moveactive]]'\
old_end = 'hl.bind(mainMod .. " + SHIFT + CONTROL + down",  hl.dsp.exec_cmd(moveActive .. " 0 30 || hyprctl dispatch movewindow d"),  { repeating = true })'\
\
start = lines.index(old_start)\
end = lines.index(old_end)\
\
new_block = [\
'local function moveWindowSmart(x, y, direction)',\
'    return function()',\
'        local win = hl.get_active_window()',\
'        if not win then return end',\
'',\
'        if win.floating then',\
'            hl.dispatch(hl.dsp.window.move({',\
'                x = x,',\
'                y = y,',\
'                relative = true,',\
'            }))',\
'        else',\
'            hl.dispatch(hl.dsp.window.move({',\
'                direction = direction,',\
'            }))',\
'        end',\
'    end',\
'end',\
'',\
'hl.bind(mainMod .. " + SHIFT + CONTROL + left",  moveWindowSmart(-30, 0, "l"), { repeating = true })',\
'hl.bind(mainMod .. " + SHIFT + CONTROL + right", moveWindowSmart(30, 0, "r"),  { repeating = true })',\
'hl.bind(mainMod .. " + SHIFT + CONTROL + up",    moveWindowSmart(0, -30, "u"), { repeating = true })',\
'hl.bind(mainMod .. " + SHIFT + CONTROL + down",  moveWindowSmart(0, 30, "d"),  { repeating = true })',\
]\
\
lines[start:end + 1] = new_block\
\
# ----- SCRATCHPAD / SPECIAL WORKSPACE -----\
old = 'hl.bind(mainMod .. " + ALT + S", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspacesilent special"))'\
new = 'hl.bind(mainMod .. " + ALT + S", hl.dsp.window.move({ workspace = "special:scratchpad", follow = false }))'\
assert lines.count(old) == 1\
lines[lines.index(old)] = new\
\
old = 'hl.bind(mainMod .. " + S", hl.dsp.exec_cmd("hyprctl dispatch togglespecialworkspace"))'\
new = 'hl.bind(mainMod .. " + S", hl.dsp.workspace.toggle_special("scratchpad"))'\
assert lines.count(old) == 1\
lines[lines.index(old)] = new\
\
# Cambiar tambi√©n el bind que enviaba al special gen√©rico\
old = 'hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special" }))'\
new = 'hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:scratchpad" }))'\
assert lines.count(old) == 1\
lines[lines.index(old)] = new\
\
# ----- ALT + N√É∫MEROS: MOVIMIENTO SILENCIOSO -----\
old = '    hl.bind(mainMod .. " + ALT + " .. i, hl.dsp.exec_cmd("hyprctl dispatch movetoworkspacesilent " .. i))'\
new = '    hl.bind(mainMod .. " + ALT + " .. i, hl.dsp.window.move({ workspace = i, follow = false }))'\
assert lines.count(old) == 1\
lines[lines.index(old)] = new\
\
old = 'hl.bind(mainMod .. " + ALT + 0", hl.dsp.exec_cmd("hyprctl dispatch movetoworkspacesilent 10"))'\
new = 'hl.bind(mainMod .. " + ALT + 0", hl.dsp.window.move({ workspace = 10, follow = false }))'\
assert lines.count(old) == 1\
lines[lines.index(old)] = new\
\
p.write_text("\n".join(lines) + "\n")\
\
print("OK: dispatchers antiguos migrados")\
PY
