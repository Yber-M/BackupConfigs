        -o pid,ppid,stat,psr,pcpu,pmem,etime,rss,vsz,wchan:32,args\
\
      echo\
      echo '=== THREADS TOP CPU ==='\
      ps -L -p "$mainpid" \\
        -o pid,tid,psr,stat,pcpu,pmem,wchan:32,comm \\
        --sort=-pcpu | head -n 40\
    fi\
\
    echo\
    echo '=== TODOS LOS PROCESOS DISCORD ==='\
    ps -eo pid,ppid,stat,psr,pcpu,pmem,etime,rss,args |\
      grep -E "$HOME/.config/discord/app-[^/]*/Discord" |\
