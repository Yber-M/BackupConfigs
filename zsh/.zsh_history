from pathlib import Path\
\
src = Path.home() / ".config/hypr/hyprlock/HyDE.conf"\
dst = Path.home() / ".config/hypr/hyprlock/standalone.conf"\
\
text = src.read_text()\
\
header = r'''# Hyprlock standalone\
# Migrado desde el antiguo layout HyDE.\
# No depende de HyDE, wallbash, font.sh, battery.sh ni hyde-shell.\
\
$BACKGROUND_PATH = /home/yb-m/.cache/hyprlock/wallpaper.png\
\
$wallbash_txt1_rgba = rgba(255,255,255,0.95)\
$wallbash_txt2_rgba = rgba(255,255,255,0.95)\
$wallbash_pry2_rgba = rgba(63,48,114,0.95)\
$wallbash_pry4_rgba = rgba(212,131,203,0.95)\
$wallbash_3xa9_rgba = rgba(204,210,255,0.95)\
$wallbash_4xa9_rgba = rgba(255,204,249,0.95)\
$text = rgba(255,255,255,0.95)\
\
'''\
\
# Quitar encabezado viejo.\
marker = "# Local Variables"\
pos = text.find(marker)\
assert pos != -1, "No encontr√© '# Local Variables'"\
\
text = header + text[pos:]\
\
# Car√ÉÅtula MPRIS: ya no usar cache de HyDE.\
old = '''    path = $MPRIS_IMAGE\
    size = 150 # lesser side if not 1:1 ratio\
    reload_time = 0 # seconds between reloading, 0 to reload with SIGUSR2\
    reload_cmd = # command to get new path. if empty, old path will be used. don't run "follow" commands like tail -F\
'''\
\
new = '''    path =\
    size = 150\
    rounding = -1\
    reload_time = 2\
    reload_cmd = /home/yb-m/.config/hypr/scripts/hyprlock-media.sh art\
'''\
\
count = text.count(old)\
assert count == 1, f"Bloque MPRIS esperado: 1, encontrado: {count}"\
text = text.replace(old, new, 1)\
\
# Texto multimedia.\
old = '''    text = cmd[update:1000] $SPLASH_CMD # Outputs the song title when mpris is available, otherwise, it will output the splash command.'''\
new = '''    text = cmd[update:1000] /home/yb-m/.config/hypr/scripts/hyprlock-media.sh text'''\
\
count = text.count(old)\
assert count == 1, f"Texto MPRIS esperado: 1, encontrado: {count}"\
text = text.replace(old, new, 1)\
\
# Bater√≠a.\
old = '''    text = cmd[update:5000] $BATTERY_ICON'''\
new = '''    text = cmd[update:5000] /home/yb-m/.config/hypr/scripts/hyprlock-battery.sh'''\
\
count = text.count(old)\
assert count == 1, f"Bater√≠a esperada: 1, encontrada: {count}"\
text = text.replace(old, new, 1)\
\
# Subir bater√≠a para que no se superponga con el layout de teclado.\
battery_old = '''    position = -1%, 1%\
    halign = right\
    valign = bottom\
}\
\
# Current Keyboard Layout'''\
\
battery_new = '''    position = -2%, 5%\
    halign = right\
    valign = bottom\
}\
\
# Current Keyboard Layout'''\
\
count = text.count(battery_old)\
assert count == 1, f"Posici√≥n bater√≠a esperada: 1, encontrada: {count}"\
text = text.replace(battery_old, battery_new, 1)\
\
dst.write_text(text)\
\
print(f"OK: creado {dst}")\
PY
