    pattern="^$HOME/.config/discord/app-[^/]*/Discord( |$)"\
    pgrep -af "$pattern"\
\
    mainpid="$(\
      pgrep -af "$pattern" |\
      awk '$0 !~ /--type=/ {print $1; exit}'\
    )"\
\
    echo\
    echo "MAIN PID: ${mainpid:-NO ENCONTRADO}"\
\
    if [[ -n "$mainpid" ]]; then\
