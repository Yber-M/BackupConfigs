: 1787877387:0;echo "=== 1. EJECUTABLE DE DISCORD ==="\
command -v discord\
type -a discord\
readlink -f "$(command -v discord)"\
\
echo\
echo "=== 2. PAQUETE INSTALADO ==="\
pacman -Qo "$(command -v discord)" 2>/dev/null\
pacman -Q | grep -iE '^discord|vesktop|webcord'\
\
echo\
echo "=== 3. RUTAS XDG REALES ==="\
printf 'HOME=%s\n' "$HOME"\
printf 'XDG_CONFIG_HOME=%s\n' "${XDG_CONFIG_HOME:-NO_DEFINIDO}"\
printf 'XDG_DATA_HOME=%s\n' "${XDG_DATA_HOME:-NO_DEFINIDO}"\
printf 'XDG_CONFIG_DIRS=%s\n' "${XDG_CONFIG_DIRS:-NO_DEFINIDO}"\
printf 'XDG_DATA_DIRS=%s\n' "${XDG_DATA_DIRS:-NO_DEFINIDO}"\
\
echo\
echo "=== 4. DESKTOP ENTRIES DE DISCORD ==="\
find "$HOME" /usr/share/applications /usr/local/share/applications \\
  -maxdepth 5 -type f \\
  \( -iname '*discord*.desktop' -o -iname 'discord.desktop' \) \\
  2>/dev/null\
\
echo\
echo "=== 5. CONTENIDO EXEC DE LOS DESKTOP ENCONTRADOS ==="\
while IFS= read -r f; do\
    echo "--- $f"\
    grep -nE '^(Name|Exec|TryExec|DBusActivatable)=' "$f"\
done < <(\
    find "$HOME" /usr/share/applications /usr/local/share/applications \\
      -maxdepth 5 -type f \\
      \( -iname '*discord*.desktop' -o -iname 'discord.desktop' \) \\
      2>/dev/null\
)\
\
echo\
echo "=== 6. AUTOSTART XDG RELACIONADO CON DISCORD ==="\
find "$HOME" -maxdepth 5 -type f \\
  -path '*/autostart/*' \\
  -iname '*discord*.desktop' \\
  -print 2>/dev/null\
\
echo\
echo "=== 7. REFERENCIAS A DISCORD EN CONFIGURACION HYPRLAND ==="\
grep -RniE 'discord|exec-once.*discord' \\
  "${XDG_CONFIG_HOME:-$HOME/.config}" \\
  --include='*.conf' \\
  --include='*.sh' \\
  2>/dev/null | head -100\
\
echo\
echo "=== 8. PATH DEL USUARIO ==="\
printf '%s\n' "$PATH" | tr ':' '\n'
