import { createPoll } from "ags/time";\
import { execAsync } from "ags/process";\
\
const CHECK_INTERVAL = 30 * 60 * 1000; // 30 minutos\
\
export const updateCount = createPoll<number>(0, CHECK_INTERVAL, async () => {\
  try {\
    const [pacmanRes, aurRes] = await Promise.allSettled([\
      execAsync(["bash", "-c", "checkupdates 2>/dev/null | wc -l"]),\
      execAsync(["bash", "-c", "yay -Qua 2>/dev/null | wc -l"]),\
    ]);\
\
    const pacmanCount =\
      pacmanRes.status === "fulfilled"\
        ? parseInt(pacmanRes.value.trim()) || 0\
        : 0;\
    const aurCount =\
      aurRes.status === "fulfilled" ? parseInt(aurRes.value.trim()) || 0 : 0;\
\
    return pacmanCount + aurCount;\
  } catch (error) {\
    console.error("Failed to check updates:", error);\
    return 0;\
  }\
});\
EOF
