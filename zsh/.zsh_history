while read -r f; do\
  width=$(sed -r 's/\x1b\[[0-9;]*[a-zA-Z]//g' "$f" 2>/dev/null | awk '{ print length }' | sort -n | tail -1)\
  height=$(wc -l < "$f" 2>/dev/null)\
  echo "$f|$width|$height" >> ~/arte-medidas.txt\
done < ~/arte-favoritos.txt\
\
sort -t'|' -k2 -n ~/arte-medidas.txt | column -t -s'|'
