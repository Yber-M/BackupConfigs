from pathlib import Path\
import sys\
\
p = Path(sys.argv[1])\
\
if p.exists():\
    lines = p.read_text().splitlines()\
else:\
    lines = []\
\
# Buscar secci√≥n [Default]\
try:\
    start = lines.index("[Default]")\
except ValueError:\
    if lines and lines[-1].strip():\
        lines.append("")\
    lines.extend([\
        "[Default]",\
        "early_exit=true",\
    ])\
else:\
    # Encontrar hasta d√≥nde llega [Default]\
    end = len(lines)\
    for i in range(start + 1, len(lines)):\
        if lines[i].strip().startswith("[") and lines[i].strip().endswith("]"):\
            end = i\
            break\
\
    found = False\
    for i in range(start + 1, end):\
        if lines[i].strip().startswith("early_exit="):\
            lines[i] = "early_exit=true"\
            found = True\
            break\
\
    if not found:\
        lines.insert(end, "early_exit=true")\
\
p.write_text("\n".join(lines) + "\n")\
print(f"OK: {p}")\
PY
