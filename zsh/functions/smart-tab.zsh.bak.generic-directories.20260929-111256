#!/usr/bin/env zsh

# TAB completamente independiente del historial predictivo.
#
# Solo completa directorios/rutas.
# Nunca reutiliza sugerencias de zsh-autocomplete.

autoload -Uz _files

_yb_directory_only_completion() {
    # Nunca reutilizar la lista predictiva previa.
    compstate[old_list]=''

    # -/ = solamente directorios.
    _files -/
}

# Mantenemos el mismo nombre del widget para no tocar bindings.
zle -C yb-smart-tab complete-word _yb_directory_only_completion
