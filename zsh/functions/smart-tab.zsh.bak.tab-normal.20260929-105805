#!/usr/bin/env zsh

# Tab normal aun cuando zsh-autocomplete esté usando
# history-incremental-search-backward como contexto por defecto.

_yb_smart_tab() {
    local saved_context="${curcontext-}"

    typeset -g curcontext=""

    zle complete-word

    typeset -g curcontext="$saved_context"
}

zle -N yb-smart-tab _yb_smart_tab
