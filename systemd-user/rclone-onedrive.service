[Unit]
Description=Rclone OneDrive Mount
After=network-online.target

[Service]
ExecStart=/usr/bin/rclone mount onedrive: /home/yb-m/OneDrive \
  --vfs-cache-mode full \
  --vfs-cache-max-size 2G \
  --vfs-cache-max-age 1h \
  --buffer-size 64M \
  --dir-cache-time 24h \
  --poll-interval 1m \
  --allow-other \
  --umask 000
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
