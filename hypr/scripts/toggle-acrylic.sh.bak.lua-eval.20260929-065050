#!/usr/bin/env bash

STATE="/tmp/hypr-acrylic-solid"
GAME_STATE="/tmp/hypr-gamemode"

if [ -f "$STATE" ]; then
    rm -f "$STATE"

    if [ -f "$GAME_STATE" ]; then
        # GameMode tiene prioridad: debe seguir sólido.
        hyprctl keyword decoration:blur:enabled false
        hyprctl keyword decoration:active_opacity 1.0
        hyprctl keyword decoration:inactive_opacity 1.0
        notify-send "Acrílico" "GameMode activo: se mantiene modo sólido"
    else
        hyprctl keyword decoration:blur:enabled true
        hyprctl keyword decoration:active_opacity 0.95
        hyprctl keyword decoration:inactive_opacity 0.88
        notify-send "Acrílico ON"
    fi
else
    hyprctl keyword decoration:blur:enabled false
    hyprctl keyword decoration:active_opacity 1.0
    hyprctl keyword decoration:inactive_opacity 1.0

    touch "$STATE"
    notify-send "Modo sólido ON"
fi
