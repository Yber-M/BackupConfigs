#!/usr/bin/env bash

STATE="/tmp/hypr-gamemode"
ACRYLIC_STATE="/tmp/hypr-acrylic-solid"

if [ -f "$STATE" ]; then
    # GameMode OFF
    rm -f "$STATE"

    hyprctl keyword animations:enabled 1

    if [ -f "$ACRYLIC_STATE" ]; then
        # El usuario pidió explícitamente modo sólido.
        hyprctl keyword decoration:blur:enabled false
        hyprctl keyword decoration:active_opacity 1.0
        hyprctl keyword decoration:inactive_opacity 1.0
    else
        # Estado visual normal real de hyprland.lua.
        hyprctl keyword decoration:blur:enabled true
        hyprctl keyword decoration:active_opacity 0.95
        hyprctl keyword decoration:inactive_opacity 0.88
    fi

    notify-send "GameMode OFF"
else
    # GameMode ON: rendimiento + sólido.
    hyprctl keyword animations:enabled 0
    hyprctl keyword decoration:blur:enabled false
    hyprctl keyword decoration:active_opacity 1.0
    hyprctl keyword decoration:inactive_opacity 1.0

    touch "$STATE"
    notify-send "GameMode ON"
fi
