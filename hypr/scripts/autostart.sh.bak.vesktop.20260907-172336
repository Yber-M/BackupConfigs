#!/bin/bash

LOCK="/tmp/hypr-autostart-${HYPRLAND_INSTANCE_SIGNATURE}.lock"

exec 9>"$LOCK"
flock -n 9 || exit 0

sleep 1

pgrep -x awww-daemon >/dev/null || awww-daemon &

#~/.config/hypr/scripts/patch-waybar-cava.sh

#killall -SIGUSR2 waybar 2>/dev/null

sleep 2
pgrep -x copyq >/dev/null || copyq &
pgrep -x ferdium >/dev/null || ferdium &
pgrep -x cider >/dev/null || cider &
pgrep -f cider-notify.sh >/dev/null || ~/.local/bin/cider-notify.sh &

# Discord - flags para evitar crash al compartir pantalla
# DISABLED TEMPORARILY - Vesktop test: pgrep -f "^$HOME/.config/discord/app-[^/]*/Discord( |$)" >/dev/null || "$HOME/.local/bin/discord" &
