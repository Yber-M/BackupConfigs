{
  "app.audio": "pwvucontrol",
  "app.bluetooth": "overskride",
  "app.browser": "zen-browser",
  "app.file-manager": "nautilus",
  "app.resource-monitor": "resources",
  "app.terminal": "kitty",
  "app.wifi": "XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi",
  "bar.position": "top",
  "bar.style": "expanded",
  "bar.modules.cava.enable": false,
  "bar.modules.cava.style": "mesh",
  "bar.modules.clients.enable": true,
  "bar.modules.media.cava.enable": false,
  "bar.modules.os-icon.type": "arch-symbolic",
  "bar.modules.os-icon.enable": true,
  "hardware-monitor.notifications.enable": true,
  "hardware-monitor.thresholds.cpu-temp": 110,
  "hardware-monitor.thresholds.gpu-temp": 110,
  "hardware-monitor.thresholds.memory": 0.95,
  "music-player.modules.cava.enable": false,
  "music-player.modules.cava.style": "wave_particles",
  "notification-center.max-notifications": 4,
  "system-menu.modules.bluetooth-advanced.enable": true,
  "system-menu.modules.wifi-advanced.enable": true,
  "wallpaper.dir": "/home/yb-m/Pictures/wallpapers",
  "wallpaper.cache-size": 50,
  "wallpaper.theme.cache-size": 100,
  "weather.update-interval": 900000
}